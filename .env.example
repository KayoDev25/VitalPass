# Copiá este archivo como ".env.local" y completalo.
# .env.local NO se sube a GitHub (está en .gitignore). Este .env.example sí, porque no tiene datos reales.
# Nunca pegues estas claves en un chat.

# --- Supabase (proyecto NUEVO) -> Project Settings > API Keys / Data API ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave "secret" (sb_secret_...) o "service_role". Es privada: solo la usa el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Hedera testnet -> portal.hedera.com (cuenta de testnet) ---
HEDERA_OPERATOR_ID=0.0.xxxxxxx
# Pegá la clave "DER Encoded" del portal
HEDERA_OPERATOR_KEY=
# Lo completa solo "pnpm hedera:setup"
HEDERA_TOPIC_ID=

# --- Stellar testnet ---
# Estas líneas las completa solo "pnpm stellar:setup" (no hace falta tocarlas)
STELLAR_SECRET_KEY=
STELLAR_PUBLIC_KEY=
STELLAR_CONTRACT_ID=
